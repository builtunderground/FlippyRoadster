rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    match /leaderboard_entries/{entryId} {
      allow read: if true;
      allow create: if isValidId(entryId) &&
                    request.resource.data.initials is string &&
                    request.resource.data.initials.size() == 3 &&
                    request.resource.data.score is number &&
                    request.resource.data.score > 0 &&
                    request.resource.data.score <= 1000000;
      allow update: if request.resource.data.initials is string &&
                    request.resource.data.initials.size() == 3;
      allow delete: if false;
    }
  }
}

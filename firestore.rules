rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['initials', 'score', 'maxSpeed', 'skinName', 'date', 'userId']) &&
        data.keys().hasOnly(['initials', 'score', 'maxSpeed', 'skinName', 'date', 'userId', 'createdAt']) &&
        data.userId == request.auth.uid &&
        data.initials is string && data.initials.size() == 3 &&
        data.score is int && data.score > 0 && data.score <= 1000000 &&
        data.maxSpeed is int && data.maxSpeed >= 0 && data.maxSpeed <= 2500 &&
        data.skinName is string && data.skinName.size() <= 60 &&
        data.date is string && data.date.size() <= 30 &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40));
    }

    match /leaderboard_entries/{entryId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(entryId) && isValidLeaderboardEntry(request.resource.data);
      allow update, delete: if false;
    }
  }
}
